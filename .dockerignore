# Secrets — never copy into the image (injected as env vars at runtime)
.env
.env.*

# The frontend has its own image; the API image doesn't need it
frontend/

# VCS / tooling
.git
.gitignore
.github/

# Python caches / build artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/
env/

# Runtime artifacts / logs
*.log
.health.json
.uvicorn.log

# OS / IDE
.DS_Store
.vscode/
.idea/
