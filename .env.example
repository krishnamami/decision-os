# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).

# Postgres connection for the Accord data (e.g. AWS RDS).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Anthropic key — enables the MiroFish debate/simulate Claude paths.
# (Deterministic fallbacks run without it.)
ANTHROPIC_API_KEY=sk-ant-...

# Redis for hot-cache / context store. In docker-compose this defaults to the
# bundled redis service (redis://redis:6379).
REDIS_URL=redis://localhost:6379

# Secret for signing JWT access tokens — MUST be a strong random value in prod.
JWT_SECRET=change-me-in-production

# Frontend API base. Leave EMPTY in production so the app calls /api/ on the
# same origin (nginx proxies it). Set to http://localhost:8000 for the Vite
# dev server talking to a locally-run backend.
VITE_API_URL=http://localhost:8000
